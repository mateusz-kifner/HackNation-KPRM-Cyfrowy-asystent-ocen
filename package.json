{
  "name": "template-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "auth:regen": "pnpm dlx auth@latest generate --output ./src/db/schema/auth.ts --adapter drizzle --dialect sqlite --yes",
    "seed": "tsx src/db/seed.ts",
    "db:reset": "rm -f dev.db prod.db && pnpm db:push && pnpm seed",
    "pkg-up": "ncu -u -i -c 31d -p pnpm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
